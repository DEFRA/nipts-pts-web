@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment
@{
    // Inline the crest as a local base64 data URI; the PDF renderer gets HTML via SetContentAsync with no base URL, so it cannot fetch external/relative images.
    string crestSrc = null;
    var crestPath = WebHostEnvironment.WebRootPath is { } webRoot
        ? System.IO.Path.Combine(webRoot, "assets", "images", "HMGFullSize.png")
        : null;
    if (crestPath != null && System.IO.File.Exists(crestPath))
    {
        var crestData = System.Convert.ToBase64String(await System.IO.File.ReadAllBytesAsync(crestPath));
        crestSrc = $"data:image/png;base64,{crestData}";
    }
}
<div class="govuk-grid-row pet-declaration-print-logo">
    <div class="govuk-grid-column-two-thirds">
        <div class="gem-c-organisation-logo pet-logo-print">
            <img src="@(crestSrc ?? Url.Content("~/assets/images/HMGFullSize.png"))" alt="UK Government coat of arms with the words 'UK Government'" style="height:45px;width:auto;padding:5px 0 0 5px;" />
        </div>
    </div>
</div>